FROM python:3.12-slim
WORKDIR /opt/fusion
COPY bridge bridge
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
ENV PYTHONPATH=/opt/fusion
ENV PYTHONUNBUFFERED=1
EXPOSE 8710
CMD ["python", "-m", "bridge.harness", "serve", "--role", "avrone", "--host", "0.0.0.0", "--port", "8710"]
